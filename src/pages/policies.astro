    <div style="max-width:680px; margin:0 auto; padding:48px 24px 90px;">
      <a href="/" style="display:flex; align-items:center; gap:10px; text-decoration:none;">
        <img src="/logo.png" alt="" style="height:34px; width:34px;" />
        <span style="font-family:'Cormorant Garamond',serif; font-size:26px; font-weight:600; color:#1E3D33;">Sorgente</span>
