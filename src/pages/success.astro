---
const sessionId = Astro.url.searchParams.get("session_id");
const isTasting = Astro.url.searchParams.get("tasting") === "1";
import SiteHead from "../components/SiteHead.astro";
---
<html lang="en">
  <head>
    <SiteHead />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Welcome to Sorgente</title>
    <link rel="icon" href="/favicon.png" />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Jost:wght@300;400;500&display=swap" rel="stylesheet" />
  </head>
  <body style="margin:0; min-height:100vh; background:#FBFCFB; display:flex; align-items:center; justify-content:center; font-family:'Jost',sans-serif; padding:24px;">
    <div style="max-width:460px; text-align:center;">
      <div style="font-family:'Cormorant Garamond',serif; font-size:42px; color:#1E3D33; font-weight:500; line-height:1.15;">
        {isTasting ? "Your Tasting Case is reserved." : "Your first delivery is set."}
      </div>
      <p style="color:#5B6D66; font-size:16px; line-height:1.7; margin-top:18px;">
        {isTasting
          ? "Watch for a text from (561) 401-0695 confirming your delivery day. Reply there with any gate codes or a preferred drop spot — and remember, your $50 is credited in full toward your first month."
          : "Thank you — your subscription is active. We'll confirm your first delivery by email shortly, carry everything to your pantry on the day, and repeat monthly. Traveling? Just write us and we'll hold your deliveries."}
      </p>
      <p style="color:#8FA39B; font-size:13px; margin-top:22px;">
        matthew@growpalmbeach.com {sessionId ? "· ref " + sessionId.slice(-8) : ""}
      </p>
    </div>
  <script is:inline>
      (function () {
        var isTasting = new URLSearchParams(location.search).get("tasting") === "1";
        var sid = new URLSearchParams(location.search).get("session_id") || undefined;
        try {
          if (window.fbq) {
            if (isTasting) fbq("track", "Purchase", { value: 50, currency: "USD" }, { eventID: sid });
            else fbq("track", "Subscribe", {}, { eventID: sid });
          }
        } catch (e) {}
        try {
          if (window.gtag) gtag("event", "purchase", { transaction_id: sid, currency: "USD", value: isTasting ? 50 : undefined });
        } catch (e) {}
      })();
    </script>
  </body>
</html>
